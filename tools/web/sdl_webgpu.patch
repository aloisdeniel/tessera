+static inline void WEBGPU_INTERNAL_WebGPUProcessEvents(WGPUInstance instance)
+{
+    wgpuInstanceProcessEvents(instance);
+#ifdef __EMSCRIPTEN__
+    emscripten_sleep(1);
+#endif
+}
