+static void WEBGPU_Blit(SDL_GPUCommandBuffer *commandBuffer, const SDL_GPUBlitInfo *info)
+{
+    WebGPURenderer *renderer = ((WebGPUCommandBuffer *)commandBuffer)->renderer;
