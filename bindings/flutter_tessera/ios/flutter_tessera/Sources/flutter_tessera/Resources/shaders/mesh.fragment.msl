#include <metal_stdlib>
using namespace metal;

struct FrameUniform {
    float4x4 view_proj;
    float4   light_dir;    // xyz direction the light travels
    float4   ambient;      // rgb ambient
    float4   light_color;  // rgb color, a = intensity
    float4   camera_pos;   // xyz eye position, w unused
    float4x4 light_vp;     // world -> light clip (shadow map)
    float4   shadow_params;// x enable, y 1/resolution, z const bias, w slope bias
    float4   point_count;  // x = live point-light count
    float4   point_pos[8];   // xyz world pos, w falloff radius
    float4   point_color[8]; // rgb color, a intensity
};
struct VSOut {
    float4 position [[position]];
    float3 world_pos;
    float3 normal;
    float2 uv;
    float4 tint;
};

// Approximate sRGB <-> linear so authored colours and textures light correctly
// and the board reads consistently across Metal / Vulkan.
static inline float3 srgb_to_linear(float3 c) { return pow(max(c, 0.0), 2.2); }
static inline float3 linear_to_srgb(float3 c) { return pow(max(c, 0.0), 1.0 / 2.2); }

// Cel ramp: quantise diffuse into a few soft bands for a stylised board-game
// look. Soft edges keep it from aliasing badly on curved meshes.
static inline float cel_ramp(float ndl) {
    const float bands = 3.0;
    float scaled = ndl * bands;
    float lower  = floor(scaled);
    float frac   = scaled - lower;
    // narrow smooth transition between adjacent bands
    float soft   = smoothstep(0.35, 0.65, frac);
    return (lower + soft) / bands;
}

// Summed cel-shaded contribution of the live point lights: lambert quantised
// through the same ramp as the sun, with a smooth quadratic falloff to each
// light's radius. Colors follow the directional light's convention (applied
// on linear albedo without re-linearising the light color itself).
static float3 point_light_sum(float3 world_pos, float3 n,
                              constant FrameUniform& frame) {
    float3 sum = float3(0.0);
    uint count = min(uint(frame.point_count.x), 8u);
    for (uint i = 0u; i < count; ++i) {
        float3 toL = frame.point_pos[i].xyz - world_pos;
        float dist = length(toL);
        float radius = max(frame.point_pos[i].w, 1e-3);
        if (dist >= radius) continue;
        float att = 1.0 - dist / radius;
        att *= att;
        float ndl = max(dot(n, toL / max(dist, 1e-4)), 0.0);
        sum += frame.point_color[i].rgb * frame.point_color[i].a *
               cel_ramp(ndl) * att;
    }
    return sum;
}

// Directional shadow-map visibility: project into light clip space, 3x3 PCF
// with a slope-scaled bias (tuned at board scale against acne/peter-panning).
// Returns 1 when unshadowed / mapping disabled / outside the fitted map.
static float shadow_visibility(float3 world_pos, float ndl,
                               constant FrameUniform& frame,
                               depth2d<float> smap, sampler ssamp) {
    if (frame.shadow_params.x < 0.5) return 1.0;
    float4 lp = frame.light_vp * float4(world_pos, 1.0);
    float3 p = lp.xyz / lp.w;
    float2 uv = float2(0.5 + 0.5 * p.x, 0.5 - 0.5 * p.y);
    if (uv.x <= 0.0 || uv.x >= 1.0 || uv.y <= 0.0 || uv.y >= 1.0 ||
        p.z <= 0.0 || p.z >= 1.0) return 1.0;
    float bias  = max(frame.shadow_params.z, frame.shadow_params.w * (1.0 - ndl));
    float texel = frame.shadow_params.y;
    float ref   = p.z - bias;
    float lit = 0.0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            float d = smap.sample(ssamp, uv + float2(dx, dy) * texel);
            lit += ref <= d ? 1.0 : 0.0;
        }
    return lit / 9.0;
}

fragment float4 fs_main(VSOut in [[stage_in]],
                        constant FrameUniform& frame [[buffer(0)]],
                        texture2d<float> tex [[texture(0)]],
                        depth2d<float> shadow_map [[texture(1)]],
                        sampler samp [[sampler(0)]],
                        sampler shadow_samp [[sampler(1)]])
{
    float3 n = normalize(in.normal);
    float3 L = normalize(-frame.light_dir.xyz);
    float3 V = normalize(frame.camera_pos.xyz - in.world_pos);

    float4 texel = tex.sample(samp, in.uv) * in.tint;
    float3 albedo = srgb_to_linear(texel.rgb);

    float ndl   = max(dot(n, L), 0.0);
    float ramp  = cel_ramp(ndl);
    float vis   = shadow_visibility(in.world_pos, ndl, frame, shadow_map, shadow_samp);

    float3 ambient = srgb_to_linear(frame.ambient.rgb);
    float3 direct  = frame.light_color.rgb * frame.light_color.a * ramp * vis;
    float3 point   = point_light_sum(in.world_pos, n, frame);
    float3 lit     = albedo * (ambient + direct + point);

    // Subtle Fresnel rim to lift silhouettes off the background.
    float rim = pow(1.0 - max(dot(n, V), 0.0), 4.0);
    lit += rim * 0.12 * frame.light_color.rgb;

    return float4(linear_to_srgb(lit), texel.a);
}
