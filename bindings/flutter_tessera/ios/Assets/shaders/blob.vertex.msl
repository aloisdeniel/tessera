#include <metal_stdlib>
using namespace metal;

struct FrameUniform {
    float4x4 view_proj;
    float4   light_dir;
    float4   ambient;
    float4   light_color;
    float4   camera_pos;
};
struct ObjectUniform {
    float4x4 model;
    float4   tint;      // rgb unused, a = shadow opacity
    float4   uv_rect;
};

struct VSIn {
    float3 pos    [[attribute(0)]];
    float3 normal [[attribute(1)]];
    float2 uv     [[attribute(2)]];
};
struct VSOut {
    float4 position [[position]];
    float2 uv;
    float  opacity;
};

vertex VSOut vs_main(VSIn in [[stage_in]],
                     constant FrameUniform&  frame [[buffer(0)]],
                     constant ObjectUniform& obj   [[buffer(1)]])
{
    VSOut out;
    float4 world = obj.model * float4(in.pos, 1.0);
    out.position = frame.view_proj * world;
    out.uv       = in.uv;
    out.opacity  = obj.tint.a;
    return out;
}
